<!-- Scene Studio's own colours (AsciiEQ's "Midnight" theme) for when it runs standalone.
     Inside AsciiEQ these keys already exist in the app's resources and follow the user's theme,
     so this dictionary is only merged when they are missing (see SceneStudioWindow). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="PrimaryColor">#FF1E1E2E</Color>
    <Color x:Key="SecondaryColor">#FF2D2D41</Color>
    <Color x:Key="AccentColor">#FF82AAFF</Color>
    <Color x:Key="BackgroundColor">#FF11111B</Color>
    <Color x:Key="SurfaceColor">#FF242433</Color>
    <Color x:Key="TextColor">#FFCDD6F4</Color>
    <Color x:Key="TextSecondaryColor">#FF9399B2</Color>
    <Color x:Key="SuccessColor">#FFA6E3A1</Color>
    <Color x:Key="WarningColor">#FFF9E2AF</Color>
    <Color x:Key="DangerColor">#FFF38BA8</Color>
    <Color x:Key="GlassColor">#18FFFFFF</Color>
    <Color x:Key="GlassBorderColor">#22FFFFFF</Color>

    <CornerRadius x:Key="Corner.Tiny">2</CornerRadius>
    <CornerRadius x:Key="Corner.Small">4</CornerRadius>
    <CornerRadius x:Key="Corner.Medium">6</CornerRadius>
    <CornerRadius x:Key="Corner.Large">8</CornerRadius>
    <CornerRadius x:Key="Corner.LeftMedium">6,0,0,6</CornerRadius>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}"/>
    <SolidColorBrush x:Key="GlassBorderBrush" Color="{StaticResource GlassBorderColor}"/>

</ResourceDictionary>
