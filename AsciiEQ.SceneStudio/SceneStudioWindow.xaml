<Window x:Class="AsciiEQ.SceneStudio.SceneStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scene Studio" Width="1180" Height="780" MinWidth="900" MinHeight="620"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Cascadia Mono, Consolas, Segoe UI" FontSize="12"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AsciiEQ.SceneStudio;component/StudioControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="SCENE STUDIO" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="New" Click="New_Click"/>
                    <Button Content="Open…" Click="Open_Click"/>
                    <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" ToolTip="Writes name.asciiscene and a name.png preview next to it (Ctrl+S)"/>
                    <Button Content="Save as…" Click="SaveAs_Click"/>
                    <Button x:Name="AddToAppButton" Content="Add to my AsciiEQ scenes" Click="AddToApp_Click" Visibility="Collapsed" ToolTip="Saves into AsciiEQ's scene folder so it shows in Themes right away"/>
                    <Button Content="Export wallpaper PNG…" Click="ExportPng_Click" ToolTip="A still of the scene at your screen size"/>
                    <Button Content="Share on asciieq.com" Click="Share_Click" ToolTip="Opens the gallery upload page; submit the .asciiscene and the .png preview Save made"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <ScrollViewer Grid.Row="1" Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,12,8,0">
            <StackPanel Margin="0,0,4,8">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="// ABOUT" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Name" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox x:Name="NameBox" MaxLength="60" TextChanged="Field_Changed"/>
                        <TextBlock Text="Your name (shown with the scene)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="AuthorBox" MaxLength="60" TextChanged="Field_Changed"/>
                        <TextBlock Text="Description" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="DescriptionBox" MaxLength="400" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="56"
                                 VerticalContentAlignment="Top" Padding="10,6" TextChanged="Field_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="// LOOK" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Pattern" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="PatternBox" SelectionChanged="Field_Changed"/>
                        <Button x:Name="PictureButton" Content="Choose picture…" Click="Picture_Click" Margin="0,8,0,0" HorizontalAlignment="Left" Visibility="Collapsed"
                                ToolTip="A photo or logo, turned into characters by brightness (kept inside the scene file, up to 2 MB)"/>
                        <TextBlock Text="Characters" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CharsetBox" SelectionChanged="Field_Changed"/>
                        <TextBlock Text="Background" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <Border x:Name="BgSwatch" Width="24" Height="24" CornerRadius="{DynamicResource Corner.Small}"
                                    BorderBrush="{DynamicResource SecondaryBrush}" BorderThickness="1" Margin="0,0,8,0" Cursor="Hand"
                                    MouseLeftButtonDown="Swatch_Click" Tag="bg" ToolTip="Click for a palette, or type a #RRGGBB"/>
                            <TextBox x:Name="BgBox" MaxLength="7" TextChanged="Color_Changed"/>
                        </DockPanel>
                        <TextBlock Text="Colours, dim to bright (1 to 4)" Style="{StaticResource FieldLabel}"/>
                        <StackPanel x:Name="ColorRows"/>
                        <TextBlock Text="Columns (detail)" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <TextBlock x:Name="ColumnsLabel" DockPanel.Dock="Right" Width="40" Style="{StaticResource ValueLabel}"/>
                            <Slider x:Name="ColumnsSlider" Minimum="60" Maximum="240" TickFrequency="10" IsSnapToTickEnabled="True" ValueChanged="Field_Changed"/>
                        </DockPanel>
                        <TextBlock Text="Opacity behind the app" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <TextBlock x:Name="OpacityLabel" DockPanel.Dock="Right" Width="40" Style="{StaticResource ValueLabel}"/>
                            <Slider x:Name="OpacitySlider" Minimum="0.02" Maximum="1" ValueChanged="Field_Changed"/>
                        </DockPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Content="Shuffle" Click="Seed_Click" Padding="10,4" Margin="8,0,0,0"/>
                            <TextBlock Text="Seed: the same seed always draws the same picture" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="// MOTION" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="ReactiveBox" Content="Live: moves with the music (Pro/Studio in AsciiEQ)" Checked="Field_Changed" Unchecked="Field_Changed"/>
                        <StackPanel x:Name="MotionPanel">
                            <TextBlock Text="Speed" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="2" ValueChanged="Field_Changed"/>
                            <TextBlock Text="Bass swells it" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="BassSlider" Minimum="0" Maximum="2" ValueChanged="Field_Changed"/>
                            <TextBlock Text="Beat flashes it" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="BeatSlider" Minimum="0" Maximum="2" ValueChanged="Field_Changed"/>
                            <TextBlock Text="Treble sparkles it" Style="{StaticResource FieldLabel}"/>
                            <Slider x:Name="TrebleSlider" Minimum="0" Maximum="2" ValueChanged="Field_Changed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Preview -->
        <Border Grid.Row="1" Grid.Column="1" Margin="4,12,12,8" Style="{StaticResource CardStyle}" Padding="8">
            <Grid>
                <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="{DynamicResource Corner.Medium}"/>
                <Image x:Name="Preview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="6"/>
            </Grid>
        </Border>

        <!-- Preview controls -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource GlassBrush}"
                BorderBrush="{DynamicResource GlassBorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="// PREVIEW" Style="{StaticResource SectionLabel}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <CheckBox x:Name="TestBeatBox" Content="Test beat" IsChecked="True" VerticalAlignment="Center" ToolTip="A fake kick drum so you can see a live scene move without playing music"/>
                    <TextBlock Text="BPM" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <Slider x:Name="BpmSlider" Minimum="60" Maximum="180" Value="120" Width="130" VerticalAlignment="Center" Margin="0"/>
                    <TextBlock x:Name="BpmLabel" Text="120" Width="30" Style="{StaticResource ValueLabel}" TextAlignment="Left" Margin="8,0,0,0"/>
                    <CheckBox x:Name="AppOpacityBox" Content="Show at app opacity" Margin="22,0,0,0" VerticalAlignment="Center" ToolTip="How it looks behind AsciiEQ's pages instead of full strength"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                           Text="Files: name.asciiscene + name.png · Import in AsciiEQ: Themes → Import…"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
