<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SceneStudio</AssemblyName>
    <RootNamespace>AsciiEQ.SceneStudio.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Scene Studio for AsciiEQ: design ASCII backgrounds that move with music (MIT).</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AsciiEQ.SceneStudio\AsciiEQ.SceneStudio.csproj" />
  </ItemGroup>

</Project>
